# Copie para .env e preencha.

# Chave da Voyage AI (usada pelo LiteLLM para voyage/voyage-code-4)
VOYAGE_API_KEY=

# Modelo de embedding no formato LiteLLM e dimensão opcional (256, 512, 1024, 2048)
EMBED_MODEL=voyage/voyage-code-4
# EMBED_DIMENSIONS=1024

# Reranker (vazio desliga) e nº de candidatos da busca híbrida enviados a ele
RERANK_MODEL=voyage/rerank-3
RERANK_CANDIDATES=40

# Postgres + pgvector (ver docker-compose.yml)
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost:5432/cocoindex

# Token para clonar repositórios privados do GitHub.
# Se vazio, usa `gh auth token` automaticamente.
# GITHUB_TOKEN=

# Estado interno do CocoIndex (LMDB), arquivo de repositórios e pasta de clones
COCOINDEX_DB=.cocoindex
# CODE_INDEX_REPOS=repos.toml
# CODE_INDEX_REPOS_DIR=.repos

# --- Servidor HTTP (API REST + MCP em /mcp): `code-index serve` ---
# Segredo do servidor (pepper dos tokens + cookie de sessão), >= 32 caracteres. OBRIGATÓRIO.
# Gere com: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CODE_INDEX_AUTH_SECRET=
# CODE_INDEX_HTTP_HOST=127.0.0.1
# CODE_INDEX_HTTP_PORT=8765
# URL pública (atrás do proxy com TLS). Define redirect do Google, cookie Secure e origem aceita.
# CODE_INDEX_PUBLIC_URL=https://code-index.example.com
# CODE_INDEX_ALLOWED_HOSTS=code-index.example.com

# Login Google (OAuth client do tipo "Web application"; redirect URI = <PUBLIC_URL>/auth/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Quem pode entrar (sem nenhum destes, ninguém entra). Listas separadas por vírgula.
# Admins: todos os scopes.
# CODE_INDEX_ADMIN_EMAILS=voce@gmail.com
# Outras contas com acesso de leitura:
# GOOGLE_ALLOWED_EMAILS=
# Opcional: todo um domínio Google Workspace (validado pelo claim `hd`):
# GOOGLE_ALLOWED_DOMAIN=

# Validade de sessões (horas) e tokens de agent (dias); rate limits por token
# CODE_INDEX_SESSION_TTL_HOURS=12
# CODE_INDEX_TOKEN_TTL_DAYS=90
# CODE_INDEX_RATE_READ_PER_MIN=120
# CODE_INDEX_RATE_SEARCH_PER_MIN=30
# CODE_INDEX_RATE_SYNC_PER_HOUR=6
